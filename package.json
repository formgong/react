{
  "name": "@formgong/react",
  "version": "0.1.0",
  "description": "React contact form without a backend: submissions go to email, Telegram and webhooks via Formgong. Works in Lovable, Bolt, v0, Next.js and Vite.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "react",
    "contact-form",
    "form-backend",
    "forms",
    "telegram",
    "gdpr",
    "lovable",
    "bolt",
    "v0",
    "nextjs",
    "vite",
    "no-backend",
    "formgong"
  ],
  "author": "Formgong <support@formgong.com>",
  "license": "MIT",
  "homepage": "https://formgong.com/en/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formgong/react.git"
  },
  "bugs": {
    "url": "https://github.com/formgong/react/issues",
    "email": "support@formgong.com"
  }
}
